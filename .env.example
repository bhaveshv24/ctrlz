CTRLZ_OPERATOR_TOKEN=replace-with-a-random-local-operator-token
SERVICE_RECOVERY_TOKEN=replace-for-your-integrated-service
# Optional CampusPass demonstration integration
CAMPUSPASS_RECOVERY_TOKEN=must-match-campuspass-recovery-token
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MAX_TOKENS=8192
NVIDIA_ENABLE_THINKING=false
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Local SQLite; hosted setup: docs/SUPABASE_SETUP.md (Render only, never VITE_).
DATABASE_URL=sqlite:///./ctrlz.db
DATA_DIR=./data
RUNBOOK_DIR=../runbooks
IMPORT_ROOT=../imports
MONITOR_INTERVAL=5
CTRLZ_DEMO_CONTROLS_ENABLED=false
CREWAI_STORAGE_DIR=./data/crewai
CREWAI_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=true

# Allowed local source directories, separated by the OS path separator.
# Defaults to the directory containing the CtrlZ checkout.
REPOSITORY_SOURCE_ROOTS=../..

# Optional read-only GitHub API token; never sent to the browser.
GITHUB_TOKEN=

# Email accounts: first start creates two admins and one private user workspace.
# Leave passwords blank to generate random values in DATA_DIR/initial-credentials.txt (mode 600).
# Changing seed variables does not overwrite an existing account password.
CTRLZ_ADMIN_1_EMAIL=admin1@ctrlz.local
CTRLZ_ADMIN_1_PASSWORD=
CTRLZ_ADMIN_2_EMAIL=admin2@ctrlz.local
CTRLZ_ADMIN_2_PASSWORD=
CTRLZ_USER_EMAIL=user@ctrlz.local
CTRLZ_USER_PASSWORD=
CTRLZ_ALLOW_REGISTRATION=true
CTRLZ_ALLOW_OPERATOR_TOKEN=false
CTRLZ_CODE_EXECUTION_ENABLED=true
CTRLZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
