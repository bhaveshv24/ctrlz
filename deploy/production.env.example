# Template only. Store actual files outside Git and give them mode 600.
# CtrlZ backend .env (never frontend or Caddy environment):
CTRLZ_OPERATOR_TOKEN=
CAMPUSPASS_RECOVERY_TOKEN=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_TOKENS=8192
NVIDIA_ENABLE_THINKING=false
DATABASE_URL=sqlite:////srv/agentathon/ctrlz/backend/data/ctrlz.db
DATA_DIR=/srv/agentathon/ctrlz/backend/data
CREWAI_STORAGE_DIR=/srv/agentathon/ctrlz/backend/data/crewai
RUNBOOK_DIR=/srv/agentathon/ctrlz/runbooks
IMPORT_ROOT=/srv/agentathon/ctrlz/imports
REPLAY_CAMPUSPASS_DIR=/srv/agentathon/campuspass
CTRLZ_DEMO_CONTROLS_ENABLED=false
CREWAI_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=true
# For full isolated A/replay on a VM, configure the actual rootless daemon socket:
# DOCKER_HOST=unix:///run/user/ACTUAL_SERVICE_UID/docker.sock

# Separate CampusPass backend .env:
# RECOVERY_TOKEN=<must match CAMPUSPASS_RECOVERY_TOKEN>
# DATABASE_URL=sqlite:////srv/agentathon/campuspass/backend/data/campuspass.db
# DEMO_MODE=false

# Separate Caddy environment, containing no API or recovery keys:
# CTRLZ_DOMAIN=ctrlz.your-domain.example
# CAMPUSPASS_DOMAIN=campuspass.your-domain.example
# ACME_EMAIL=your-admin-email

# Email account deployment
CTRLZ_ALLOW_REGISTRATION=false
CTRLZ_ALLOW_OPERATOR_TOKEN=false
CTRLZ_CODE_EXECUTION_ENABLED=true
CTRLZ_CORS_ORIGINS=https://your-frontend.example
CTRLZ_ADMIN_1_EMAIL=admin1@your-domain.example
CTRLZ_ADMIN_1_PASSWORD=
CTRLZ_ADMIN_2_EMAIL=admin2@your-domain.example
CTRLZ_ADMIN_2_PASSWORD=
CTRLZ_USER_EMAIL=user@your-domain.example
CTRLZ_USER_PASSWORD=
